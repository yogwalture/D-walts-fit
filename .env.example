# ---------------------------------------------------------------------------
# Gym Management & Fitness Cloud — environment template
#
# Copy to .env for local development. NEVER commit a filled-in .env.
# In production these are set in the Hostinger deploy configuration,
# and in CI they are GitHub Actions secrets.
# ---------------------------------------------------------------------------

NODE_ENV=development
APP_URL=http://localhost:3000

# --- Database -------------------------------------------------------------
# DATABASE_URL       : the pooled connection the application uses. This role
#                      must NOT be superuser and must NOT have BYPASSRLS.
# DIRECT_DATABASE_URL: the direct, unpooled owner connection used only by
#                      `prisma migrate`. Never used at runtime.
DATABASE_URL="postgresql://gym_app:change-me@127.0.0.1:5432/gym_cloud?schema=public"
DIRECT_DATABASE_URL="postgresql://gym_owner:change-me@127.0.0.1:5432/gym_cloud?schema=public"

# --- Application secrets --------------------------------------------------
# 32-byte base64 key for AES-256-GCM encryption of per-tenant integration
# credentials. Generate with: openssl rand -base64 32
ENCRYPTION_KEY=""
# Session signing secret. Generate with: openssl rand -base64 48
AUTH_SECRET=""
# Shared secret the cron scheduler presents to /api/cron/*
CRON_SECRET=""

# --- Object storage (S3-compatible: Cloudflare R2, AWS S3, Wasabi) --------
STORAGE_ENDPOINT=""
STORAGE_REGION="auto"
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_PUBLIC_BASE_URL=""

# --- Razorpay -------------------------------------------------------------
# Test keys during development. Live keys only once a real payment is taken.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# --- Meta WhatsApp Business Cloud API -------------------------------------
# Platform-level fallback only. Per-gym credentials are stored encrypted in
# the database, never here.
WHATSAPP_API_VERSION="v21.0"
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""

# --- Firebase Cloud Messaging ---------------------------------------------
FCM_PROJECT_ID=""
FCM_CLIENT_EMAIL=""
FCM_PRIVATE_KEY=""

# --- Transactional email ---------------------------------------------------
EMAIL_PROVIDER="resend"
EMAIL_API_KEY=""
EMAIL_FROM="no-reply@example.com"

# --- Video (Cloudflare Stream) ---------------------------------------------
STREAM_ACCOUNT_ID=""
STREAM_API_TOKEN=""
STREAM_SIGNING_KEY_ID=""
STREAM_SIGNING_KEY_PEM=""

# --- Error monitoring -------------------------------------------------------
SENTRY_DSN=""
