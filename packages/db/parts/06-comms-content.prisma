// ===========================================================================
//  COMMUNICATIONS, CONTENT, INVENTORY
// ===========================================================================

/// Per-gym WhatsApp Business credentials. accessTokenEncrypted is
/// AES-256-GCM ciphertext; the key lives only in the environment, so a
/// database dump alone yields nothing usable. Write-only through the API.
model WhatsappSetting {
  id             String  @id @default(uuid(7)) @db.Uuid
  organizationId String  @unique @db.Uuid

  wabaId               String?
  phoneNumberId        String?
  displayPhoneNumber   String?
  accessTokenEncrypted String?
  webhookVerifyToken   String?
  businessName         String?

  isEnabled       Boolean   @default(false)
  isVerified      Boolean   @default(false)
  lastVerifiedAt  DateTime? @db.Timestamptz(3)
  lastErrorCode   String?
  lastErrorAt     DateTime? @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("whatsapp_settings")
}

/// organizationId null = a platform-provided default template a gym may clone.
model NotificationTemplate {
  id             String                 @id @default(uuid(7)) @db.Uuid
  organizationId String?                @db.Uuid
  key            String
  name           String
  channel        NotificationChannel
  category       MessageCategory        @default(UTILITY)
  language       String                 @default("en")

  subject String?
  body    String
  /// Variable names the body expects, e.g. ["memberName","expiryDate"]
  variables String[] @default([])

  /// Meta's approved template name — required before a WhatsApp send.
  providerTemplateName String?
  approvalStatus       TemplateApprovalStatus @default(DRAFT)
  approvalNote         String?
  submittedAt          DateTime?              @db.Timestamptz(3)
  approvedAt           DateTime?              @db.Timestamptz(3)

  isActive Boolean @default(true)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  messageJobs MessageJob[]
  messages    Message[]

  @@unique([organizationId, key, channel, language])
  @@index([organizationId, channel])
  @@map("notification_templates")
}

/// A campaign or an automation run: who it targets, when it runs, how it went.
model MessageJob {
  id             String              @id @default(uuid(7)) @db.Uuid
  organizationId String              @db.Uuid
  name           String
  channel        NotificationChannel
  category       MessageCategory     @default(UTILITY)
  templateId     String?             @db.Uuid

  /// Saved audience filter, resolved to recipients when the job runs.
  audienceFilter Json?     @db.JsonB
  scheduledAt    DateTime? @db.Timestamptz(3)
  startedAt      DateTime? @db.Timestamptz(3)
  completedAt    DateTime? @db.Timestamptz(3)
  status         MessageJobStatus @default(DRAFT)

  recipientCount Int @default(0)
  sentCount      Int @default(0)
  deliveredCount Int @default(0)
  failedCount    Int @default(0)
  skippedCount   Int @default(0)
  /// Estimate shown before dispatch and reconciled after.
  estimatedCost  Decimal @default(0) @db.Decimal(12, 2)
  actualCost     Decimal @default(0) @db.Decimal(12, 2)

  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)
  createdByUserId String?  @db.Uuid

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  template     NotificationTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  messages Message[]

  @@index([organizationId, status, scheduledAt])
  @@map("message_jobs")
}

model Message {
  id             String              @id @default(uuid(7)) @db.Uuid
  organizationId String              @db.Uuid
  messageJobId   String?             @db.Uuid
  templateId     String?             @db.Uuid

  channel       NotificationChannel
  category      MessageCategory     @default(UTILITY)
  recipientType RecipientType
  recipientId   String?             @db.Uuid
  toAddress     String

  payload   Json?         @db.JsonB
  renderedBody String?
  status    MessageStatus @default(QUEUED)

  providerMessageId String?   @unique
  providerResponse  Json?     @db.JsonB
  errorCode         String?
  errorMessage      String?
  costUnits         Decimal   @default(0) @db.Decimal(10, 4)

  queuedAt    DateTime  @default(now()) @db.Timestamptz(3)
  sentAt      DateTime? @db.Timestamptz(3)
  deliveredAt DateTime? @db.Timestamptz(3)
  readAt      DateTime? @db.Timestamptz(3)
  failedAt    DateTime? @db.Timestamptz(3)
  attempts    Int       @default(0)

  /// Guards against a double-send when a provider call times out after
  /// it actually succeeded.
  idempotencyKey String? @unique

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  messageJob   MessageJob?           @relation(fields: [messageJobId], references: [id], onDelete: SetNull)
  template     NotificationTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@index([organizationId, status, queuedAt])
  @@index([organizationId, recipientType, recipientId])
  @@index([organizationId, channel, sentAt])
  @@map("messages")
}

/// Per-recipient, per-channel, per-category opt-in. An opt-out received
/// on WhatsApp is honoured immediately and for every later send.
model CommunicationPreference {
  id             String              @id @default(uuid(7)) @db.Uuid
  organizationId String              @db.Uuid
  subjectType    RecipientType
  subjectId      String              @db.Uuid
  channel        NotificationChannel
  category       MessageCategory
  optedIn        Boolean             @default(true)
  optedOutAt     DateTime?           @db.Timestamptz(3)
  source         String?

  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([subjectType, subjectId, channel, category])
  @@index([organizationId, subjectType, subjectId])
  @@map("communication_preferences")
}

model Notification {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @db.Uuid
  userId         String?  @db.Uuid
  memberId       String?  @db.Uuid

  title     String
  body      String?
  linkUrl   String?
  category  String?
  readAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, userId, readAt])
  @@index([organizationId, memberId, readAt])
  @@map("notifications")
}

// --------------------------------------------------------------- video ---

model VideoCategory {
  id             String  @id @default(uuid(7)) @db.Uuid
  organizationId String? @db.Uuid
  name           String
  slug           String
  description    String?
  displayOrder   Int     @default(0)
  isActive       Boolean @default(true)

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  videos       Video[]

  @@unique([organizationId, slug])
  @@map("video_categories")
}

model Video {
  id             String           @id @default(uuid(7)) @db.Uuid
  organizationId String?          @db.Uuid
  categoryId     String?          @db.Uuid

  title       String
  description String?
  /// Cloudflare Stream uid. Large files never touch the hosting plan.
  streamUid       String?        @unique
  externalUrl     String?
  thumbnailFileKey String?
  durationSeconds Int?
  tags            String[]       @default([])

  accessLevel     VideoAccessLevel @default(MEMBERS)
  requiredPlanIds String[]         @default([])
  isFeatured      Boolean          @default(false)
  isPublished     Boolean          @default(false)
  publishedAt     DateTime?        @db.Timestamptz(3)
  viewCount       Int              @default(0)

  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt       DateTime? @db.Timestamptz(3)
  createdByUserId String?   @db.Uuid

  organization Organization?  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category     VideoCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  exercises     Exercise[]
  playlistItems PlaylistItem[]
  progress      VideoProgress[]

  @@index([organizationId, isPublished])
  @@index([organizationId, categoryId])
  @@map("videos")
}

model Playlist {
  id             String  @id @default(uuid(7)) @db.Uuid
  organizationId String  @db.Uuid
  name           String
  description    String?
  isPublished    Boolean @default(false)
  displayOrder   Int     @default(0)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  items        PlaylistItem[]

  @@unique([organizationId, name])
  @@map("playlists")
}

model PlaylistItem {
  id             String @id @default(uuid(7)) @db.Uuid
  organizationId String @db.Uuid
  playlistId     String @db.Uuid
  videoId        String @db.Uuid
  displayOrder   Int    @default(0)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  playlist     Playlist     @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  video        Video        @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([playlistId, videoId])
  @@index([organizationId])
  @@map("playlist_items")
}

model VideoProgress {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @db.Uuid
  videoId        String    @db.Uuid
  memberId       String    @db.Uuid
  secondsWatched Int       @default(0)
  percentWatched Int       @default(0)
  completedAt    DateTime? @db.Timestamptz(3)
  lastWatchedAt  DateTime  @default(now()) @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  video        Video        @relation(fields: [videoId], references: [id], onDelete: Cascade)
  member       Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([videoId, memberId])
  @@index([organizationId, memberId])
  @@map("video_progress")
}

// --------------------------------------------- inventory and equipment ---

model Product {
  id             String  @id @default(uuid(7)) @db.Uuid
  organizationId String  @db.Uuid
  name           String
  category       String?
  sku            String?
  barcode        String?
  unit           String  @default("piece")
  description    String?

  purchasePrice Decimal @default(0) @db.Decimal(12, 2)
  sellingPrice  Decimal @default(0) @db.Decimal(12, 2)
  taxRateId     String? @db.Uuid

  quantityOnHand Decimal @default(0) @db.Decimal(12, 3)
  reorderLevel   Decimal @default(0) @db.Decimal(12, 3)
  supplierId     String? @db.Uuid
  imageFileKey   String?
  isActive       Boolean @default(true)

  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  taxRate      TaxRate?     @relation(fields: [taxRateId], references: [id], onDelete: SetNull)
  supplier     Vendor?      @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  movements    StockMovement[]
  invoiceLines InvoiceLine[]

  @@unique([organizationId, sku])
  @@index([organizationId, isActive])
  @@map("products")
}

model StockMovement {
  id             String            @id @default(uuid(7)) @db.Uuid
  organizationId String            @db.Uuid
  branchId       String?           @db.Uuid
  productId      String            @db.Uuid
  movementType   StockMovementType
  quantity       Decimal           @db.Decimal(12, 3)
  unitPrice      Decimal?          @db.Decimal(12, 2)
  balanceAfter   Decimal           @db.Decimal(12, 3)
  referenceType  String?
  referenceId    String?           @db.Uuid
  notes          String?

  occurredAt       DateTime @default(now()) @db.Timestamptz(3)
  recordedByUserId String?  @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([organizationId, productId, occurredAt])
  @@map("stock_movements")
}

model Equipment {
  id             String          @id @default(uuid(7)) @db.Uuid
  organizationId String          @db.Uuid
  branchId       String?         @db.Uuid
  name           String
  assetCode      String?
  category       String?
  manufacturer   String?
  modelNumber    String?
  serialNumber   String?

  purchaseDate   DateTime? @db.Date
  purchasePrice  Decimal?  @db.Decimal(12, 2)
  vendorId       String?   @db.Uuid
  warrantyUntil  DateTime? @db.Date
  status         EquipmentStatus @default(IN_SERVICE)
  location       String?
  imageFileKey   String?
  notes          String?

  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  vendor       Vendor?      @relation(fields: [vendorId], references: [id], onDelete: SetNull)

  serviceSchedules EquipmentServiceSchedule[]
  maintenanceLogs  EquipmentMaintenanceLog[]

  @@unique([organizationId, assetCode])
  @@index([organizationId, branchId, status])
  @@map("equipment")
}

model EquipmentServiceSchedule {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @db.Uuid
  equipmentId    String   @db.Uuid
  serviceType    String
  intervalDays   Int
  lastServicedOn DateTime? @db.Date
  nextDueOn      DateTime  @db.Date
  isActive       Boolean   @default(true)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  equipment    Equipment    @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  @@index([organizationId, nextDueOn, isActive])
  @@map("equipment_service_schedules")
}

model EquipmentMaintenanceLog {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @db.Uuid
  equipmentId    String   @db.Uuid
  maintenanceType String
  performedOn    DateTime @db.Date
  cost           Decimal  @default(0) @db.Decimal(12, 2)
  vendorId       String?  @db.Uuid
  partsReplaced  String?
  notes          String?
  downtimeHours  Decimal? @db.Decimal(6, 2)
  attachmentFileKey String?

  createdAt        DateTime @default(now()) @db.Timestamptz(3)
  recordedByUserId String?  @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  equipment    Equipment    @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  vendor       Vendor?      @relation(fields: [vendorId], references: [id], onDelete: SetNull)

  @@index([organizationId, equipmentId, performedOn])
  @@map("equipment_maintenance_logs")
}
