// ===========================================================================
//  Gym Management & Fitness Cloud — data model
//
//  Shared-schema multi-tenancy. Every tenant-owned model carries
//  organizationId, every tenant index leads with it, and PostgreSQL
//  row-level security enforces it independently of the application.
//
//  Conventions
//    - ids are UUID v7: time-sortable, no count leaked
//    - money is Decimal(12,2); never a float
//    - instants are timestamptz stored UTC; business days are date
//    - deletedAt marks soft deletion where history matters
//    - financial history is append-only: corrections are new rows
// ===========================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

