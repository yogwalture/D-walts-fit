// ===========================================================================
//  PLATFORM (SaaS) AND OPERATIONS
//
//  These tables are the business of selling the software. Platform revenue
//  and gym revenue are separate ledgers and never mix: tenant_invoices and
//  tenant_payments are ours; invoices and payments belong to the gym.
// ===========================================================================

model PlatformPlan {
  id          String  @id @default(uuid(7)) @db.Uuid
  key         String  @unique
  name        String
  description String?
  tagline     String?

  monthlyPrice Decimal @db.Decimal(12, 2)
  annualPrice  Decimal @db.Decimal(12, 2)
  currency     String  @default("INR")
  trialDays    Int     @default(14)

  maxMembers      Int?
  maxBranches     Int?
  maxStaff        Int?
  maxStorageMb    Int?
  whatsappCredits Int     @default(0)
  /// Feature keys this plan unlocks, checked by the permission engine.
  features        String[] @default([])

  isPublic     Boolean @default(true)
  displayOrder Int     @default(0)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  tenantSubscriptions TenantSubscription[]

  @@map("platform_plans")
}

model TenantSubscription {
  id             String                   @id @default(uuid(7)) @db.Uuid
  organizationId String                   @unique @db.Uuid
  platformPlanId String                   @db.Uuid
  status         TenantSubscriptionStatus @default(TRIAL)
  billingCycle   BillingCycle             @default(MONTHLY)

  trialEndsAt        DateTime? @db.Timestamptz(3)
  currentPeriodStart DateTime  @db.Timestamptz(3)
  currentPeriodEnd   DateTime  @db.Timestamptz(3)
  graceUntil         DateTime? @db.Timestamptz(3)
  cancelAt           DateTime? @db.Timestamptz(3)
  cancelledAt        DateTime? @db.Timestamptz(3)
  cancelReason       String?

  /// Read-only mode after grace: the gym keeps its data and can export it.
  isReadOnly Boolean @default(false)

  razorpaySubscriptionId String? @unique
  razorpayCustomerId     String?

  /// Per-tenant overrides of the plan's limits, for negotiated deals.
  limitOverrides Json? @db.JsonB

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  platformPlan PlatformPlan @relation(fields: [platformPlanId], references: [id])

  @@index([status, currentPeriodEnd])
  @@map("tenant_subscriptions")
}

model TenantInvoice {
  id             String        @id @default(uuid(7)) @db.Uuid
  organizationId String        @db.Uuid
  invoiceCode    String        @unique
  periodStart    DateTime      @db.Date
  periodEnd      DateTime      @db.Date
  subtotal       Decimal       @db.Decimal(12, 2)
  taxAmount      Decimal       @default(0) @db.Decimal(12, 2)
  total          Decimal       @db.Decimal(12, 2)
  amountPaid     Decimal       @default(0) @db.Decimal(12, 2)
  currency       String        @default("INR")
  status         InvoiceStatus @default(ISSUED)
  issueDate      DateTime      @db.Date
  dueDate        DateTime?     @db.Date
  pdfFileKey     String?
  razorpayInvoiceId String?    @unique

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  payments     TenantPayment[]

  @@index([organizationId, status])
  @@index([issueDate])
  @@map("tenant_invoices")
}

model TenantPayment {
  id              String        @id @default(uuid(7)) @db.Uuid
  organizationId  String        @db.Uuid
  tenantInvoiceId String?       @db.Uuid
  amount          Decimal       @db.Decimal(12, 2)
  currency        String        @default("INR")
  method          PaymentMethod @default(RAZORPAY)
  status          PaymentStatus @default(PENDING)

  razorpayPaymentId String? @unique
  razorpayOrderId   String?
  gatewayPayload    Json?   @db.JsonB

  paidAt        DateTime? @db.Timestamptz(3)
  failureReason String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tenantInvoice TenantInvoice? @relation(fields: [tenantInvoiceId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@map("tenant_payments")
}

/// Metered usage per tenant per period, written by the usage-metering job
/// and read by limit enforcement.
model UsageCounter {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @db.Uuid
  metric         String
  period         String
  value          Decimal  @default(0) @db.Decimal(14, 2)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, metric, period])
  @@index([metric, period])
  @@map("usage_counters")
}

model FeatureFlag {
  key         String  @id
  name        String
  description String?
  defaultOn   Boolean @default(false)
  isInternal  Boolean @default(false)

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  overrides OrgFeatureOverride[]

  @@map("feature_flags")
}

model OrgFeatureOverride {
  id             String  @id @default(uuid(7)) @db.Uuid
  organizationId String  @db.Uuid
  flagKey        String
  enabled        Boolean
  reason         String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  flag         FeatureFlag  @relation(fields: [flagKey], references: [key], onDelete: Cascade)

  @@unique([organizationId, flagKey])
  @@map("org_feature_overrides")
}

model SupportTicket {
  id             String                @id @default(uuid(7)) @db.Uuid
  organizationId String                @db.Uuid
  subject        String
  body           String
  status         SupportTicketStatus   @default(OPEN)
  priority       SupportTicketPriority @default(NORMAL)
  category       String?

  createdByUserId  String?   @db.Uuid
  assignedToUserId String?   @db.Uuid
  resolvedAt       DateTime? @db.Timestamptz(3)
  resolutionNote   String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([status, priority])
  @@index([organizationId, status])
  @@map("support_tickets")
}

model PlatformSetting {
  key       String   @id
  value     Json     @db.JsonB
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@map("platform_settings")
}

// ---------------------------------------------------------- operations ---

/// Who changed what, with before and after. organizationId is null for
/// platform-level actions. Written on every sensitive mutation.
model AuditLog {
  id             String  @id @default(uuid(7)) @db.Uuid
  organizationId String? @db.Uuid
  actorUserId    String? @db.Uuid
  actorRoleKey   String?
  /// true when platform staff acted inside a tenant for support
  isPlatformActor Boolean @default(false)

  action     String
  entityType String
  entityId   String?  @db.Uuid
  summary    String?
  beforeData Json?    @db.JsonB
  afterData  Json?    @db.JsonB

  ipAddress String?
  userAgent String?
  requestId String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        User?         @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([organizationId, entityType, entityId])
  @@index([actorUserId, createdAt])
  @@map("audit_logs")
}

/// One row per cron execution window. Inserting it IS the lock: a second
/// trigger for the same job and window finds the row and returns.
model JobRun {
  id          String       @id @default(uuid(7)) @db.Uuid
  jobKey      String
  windowKey   String
  status      JobRunStatus @default(RUNNING)
  startedAt   DateTime     @default(now()) @db.Timestamptz(3)
  finishedAt  DateTime?    @db.Timestamptz(3)
  processed   Int          @default(0)
  failed      Int          @default(0)
  skipped     Int          @default(0)
  /// Resume point, so a job spanning several ticks continues where it stopped.
  cursor      String?
  triggerSource String?
  errorMessage String?
  metadata    Json?        @db.JsonB

  @@unique([jobKey, windowKey])
  @@index([jobKey, startedAt])
  @@map("job_runs")
}

/// Side-effects written inside the business transaction and dispatched
/// later by a job. A message can therefore never be lost, and never doubled.
model Outbox {
  id             String       @id @default(uuid(7)) @db.Uuid
  organizationId String?      @db.Uuid
  topic          String
  payload        Json         @db.JsonB
  status         OutboxStatus @default(PENDING)

  availableAt DateTime  @default(now()) @db.Timestamptz(3)
  claimedAt   DateTime? @db.Timestamptz(3)
  claimToken  String?
  processedAt DateTime? @db.Timestamptz(3)
  attempts    Int       @default(0)
  lastError   String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([status, availableAt])
  @@index([organizationId, topic])
  @@map("outbox")
}

/// Replay protection for payments, webhooks and any mutating request that
/// presents an Idempotency-Key header.
model IdempotencyKey {
  id           String   @id @default(uuid(7)) @db.Uuid
  scope        String
  key          String
  requestHash  String?
  responseBody Json?    @db.JsonB
  statusCode   Int?
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  expiresAt    DateTime @db.Timestamptz(3)

  @@unique([scope, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

/// Inventory of everything in object storage, so files can be attributed,
/// quota-counted and deleted when their owner is deleted.
model FileObject {
  id             String        @id @default(uuid(7)) @db.Uuid
  organizationId String?       @db.Uuid
  storageKey     String        @unique
  bucket         String
  ownerType      FileOwnerType
  ownerId        String?       @db.Uuid
  originalName   String?
  mimeType       String?
  sizeBytes      Int           @default(0)
  checksum       String?
  isPublic       Boolean       @default(false)

  uploadedByUserId String?   @db.Uuid
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)
  deletedAt        DateTime? @db.Timestamptz(3)

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  uploadedBy   User?         @relation(fields: [uploadedByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, ownerType, ownerId])
  @@index([organizationId, deletedAt])
  @@map("files")
}

/// Export and deletion requests under India's DPDP Act.
model DataRequest {
  id             String            @id @default(uuid(7)) @db.Uuid
  organizationId String            @db.Uuid
  requestType    DataRequestType
  status         DataRequestStatus @default(REQUESTED)
  subjectType    RecipientType?
  subjectId      String?           @db.Uuid

  requestedByUserId String?   @db.Uuid
  requestedAt       DateTime  @default(now()) @db.Timestamptz(3)
  completedAt       DateTime? @db.Timestamptz(3)
  resultFileKey     String?
  rejectionReason   String?
  notes             String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@map("data_requests")
}
