// ===========================================================================
//  TENANCY AND IDENTITY
//
//  Organization is the tenant root. Every tenant-owned row in this schema
//  carries organizationId and traces back to exactly one Organization.
//  users is deliberately global: one person, one login, many gyms.
// ===========================================================================

model Organization {
  id         String             @id @default(uuid(7)) @db.Uuid
  name       String
  slug       String             @unique
  legalName  String?
  status     OrganizationStatus @default(TRIAL)
  ownerEmail String?
  createdAt  DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime           @updatedAt @db.Timestamptz(3)
  deletedAt  DateTime?          @db.Timestamptz(3)

  // tenancy and identity
  branches                Branch[]
  settings                OrgSetting?
  branding                OrgBranding?
  orgUsers                OrgUser[]
  orgUserBranches         OrgUserBranch[]
  roles                   Role[]
  rolePermissions         RolePermission[]
  userPermissionOverrides UserPermissionOverride[]
  sessions                Session[]
  consents                Consent[]

  // members and CRM
  members             Member[]
  memberDocuments     MemberDocument[]
  medicalDeclarations MemberMedicalDeclaration[]
  timelineEntries     MemberTimelineEntry[]
  leads               Lead[]
  leadActivities      LeadActivity[]
  trialBookings       TrialBooking[]

  // memberships, attendance, finance
  membershipPlans    MembershipPlan[]
  planBranches       PlanBranch[]
  subscriptions      Subscription[]
  subscriptionEvents SubscriptionEvent[]
  subscriptionFreezes SubscriptionFreeze[]
  attendance         Attendance[]
  memberQrTokens     MemberQrToken[]
  branchQrCodes      BranchQrCode[]
  invoices           Invoice[]
  invoiceLines       InvoiceLine[]
  invoiceSequences   InvoiceSequence[]
  taxRates           TaxRate[]
  payments           Payment[]
  refunds            Refund[]
  discounts          Discount[]
  expenses           Expense[]
  expenseCategories  ExpenseCategory[]
  vendors            Vendor[]

  // staff
  staffProfiles      StaffProfile[]
  staffAttendance    StaffAttendance[]
  staffShifts        StaffShift[]
  staffLeaves        StaffLeave[]
  payrollRuns        PayrollRun[]
  payrollItems       PayrollItem[]
  trainerAssignments TrainerAssignment[]

  // fitness and classes
  exercises           Exercise[]
  workoutPlans        WorkoutPlan[]
  workoutPlanDays     WorkoutPlanDay[]
  workoutPlanItems    WorkoutPlanItem[]
  workoutAssignments  MemberWorkoutAssignment[]
  workoutLogs         WorkoutLog[]
  fitnessAssessments  FitnessAssessment[]
  progressPhotos      ProgressPhoto[]
  classTypes          ClassType[]
  classes             GymClass[]
  classBookings       ClassBooking[]

  // communications and content
  whatsappSetting          WhatsappSetting?
  notificationTemplates    NotificationTemplate[]
  messageJobs              MessageJob[]
  messages                 Message[]
  communicationPreferences CommunicationPreference[]
  notifications            Notification[]
  videoCategories          VideoCategory[]
  videos                   Video[]
  playlists                Playlist[]
  playlistItems            PlaylistItem[]
  videoProgress            VideoProgress[]

  // inventory and equipment
  products                  Product[]
  stockMovements            StockMovement[]
  equipment                 Equipment[]
  equipmentServiceSchedules EquipmentServiceSchedule[]
  equipmentMaintenanceLogs  EquipmentMaintenanceLog[]

  // platform (SaaS) and operations
  paymentGateway     PaymentGatewaySetting?
  tenantSubscription TenantSubscription?
  tenantInvoices     TenantInvoice[]
  tenantPayments     TenantPayment[]
  usageCounters      UsageCounter[]
  featureOverrides   OrgFeatureOverride[]
  supportTickets     SupportTicket[]
  auditLogs          AuditLog[]
  outboxEntries      Outbox[]
  files              FileObject[]
  dataRequests       DataRequest[]

  @@index([status])
  @@index([deletedAt])
  @@map("organizations")
  memberImports    MemberImport[]
  memberImportRows MemberImportRow[]
}

model Branch {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @db.Uuid
  name           String
  code           String?
  addressLine1   String?
  addressLine2   String?
  city           String?
  state          String?
  postalCode     String?
  country        String   @default("IN")
  phone          String?
  email          String?
  timezone       String   @default("Asia/Kolkata")
  openingTime    String?
  closingTime    String?
  isPrimary      Boolean  @default(false)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)
  deletedAt      DateTime? @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  orgUserBranches    OrgUserBranch[]
  members            Member[]
  planBranches       PlanBranch[]
  subscriptions      Subscription[]
  attendance         Attendance[]
  qrCodes            BranchQrCode[]
  invoices           Invoice[]
  payments           Payment[]
  expenses           Expense[]
  leads              Lead[]
  staffAttendance    StaffAttendance[]
  staffShifts        StaffShift[]
  classes            GymClass[]
  stockMovements     StockMovement[]
  equipment          Equipment[]

  @@unique([organizationId, code])
  @@index([organizationId, isActive])
  @@map("branches")
  memberImports MemberImport[]
}

model OrgSetting {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @unique @db.Uuid

  currency        String  @default("INR")
  timezone        String  @default("Asia/Kolkata")
  dateFormat      String  @default("dd/MM/yyyy")
  locale          String  @default("en-IN")
  financialYearStartMonth Int @default(4)

  gstin           String?
  panNumber       String?
  legalAddress    Json?   @db.JsonB
  contactPhone    String?
  contactEmail    String?

  invoicePrefix        String  @default("INV")
  invoiceTermsText     String?
  receiptPrefix        String  @default("RCP")
  memberCodePrefix     String  @default("M")
  memberCodeNextNumber Int     @default(1)

  // membership rules — grace days, duplicate checks, freeze policy, etc.
  membershipRules Json? @db.JsonB
  attendanceRules Json? @db.JsonB
  enabledPaymentMethods String[] @default(["CASH", "UPI", "RAZORPAY", "CARD", "BANK_TRANSFER"])

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("org_settings")
}

model OrgBranding {
  id             String  @id @default(uuid(7)) @db.Uuid
  organizationId String  @unique @db.Uuid

  displayName    String?
  logoFileKey    String?
  faviconFileKey String?
  primaryColor   String  @default("#0F172A")
  accentColor    String  @default("#16A34A")
  theme          String  @default("system")
  loginHeadline  String?
  loginSubtext   String?
  customDomain   String? @unique
  customDomainVerifiedAt DateTime? @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("org_branding")
}

/// Global login identity. NOT tenant-scoped: one person may belong to
/// several gyms, and platform staff belong to none.
model User {
  id           String     @id @default(uuid(7)) @db.Uuid
  email        String     @unique
  emailVerifiedAt DateTime? @db.Timestamptz(3)
  phone        String?
  phoneVerifiedAt DateTime? @db.Timestamptz(3)
  passwordHash String?
  fullName     String
  avatarFileKey String?
  locale       String     @default("en-IN")
  status       UserStatus @default(INVITED)

  isPlatformAdmin Boolean @default(false)

  mfaEnabled       Boolean  @default(false)
  mfaSecret        String?
  mfaRecoveryCodes String[] @default([])

  lastLoginAt   DateTime? @db.Timestamptz(3)
  lockedUntil   DateTime? @db.Timestamptz(3)
  failedLoginCount Int    @default(0)

  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)

  orgUsers      OrgUser[]
  sessions      Session[]
  memberProfile Member[]
  auditLogs     AuditLog[]
  notifications Notification[]
  uploadedFiles FileObject[]

  @@index([status])
  @@map("users")
}

/// A user's membership of one organization, with the role they hold there.
model OrgUser {
  id             String        @id @default(uuid(7)) @db.Uuid
  organizationId String        @db.Uuid
  userId         String        @db.Uuid
  roleId         String        @db.Uuid
  status         OrgUserStatus @default(INVITED)

  invitedByUserId String?   @db.Uuid
  invitedAt       DateTime? @db.Timestamptz(3)
  acceptedAt      DateTime? @db.Timestamptz(3)

  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id])

  branches            OrgUserBranch[]
  permissionOverrides UserPermissionOverride[]
  staffProfile        StaffProfile?
  staffAttendance     StaffAttendance[]
  staffShifts         StaffShift[]
  staffLeaves         StaffLeave[]
  payrollItems        PayrollItem[]
  trainerAssignments  TrainerAssignment[]
  assignedMembers     Member[]             @relation("MemberAssignedTrainer")
  assignedLeads       Lead[]               @relation("LeadAssignedTo")
  leadActivities      LeadActivity[]
  trialBookings       TrialBooking[]
  classesTaught       GymClass[]
  workoutPlansCreated WorkoutPlan[]
  workoutAssignments  MemberWorkoutAssignment[]
  fitnessAssessments  FitnessAssessment[]

  @@unique([organizationId, userId])
  @@index([organizationId, status])
  @@index([userId])
  @@map("org_users")
}

/// Branch scope for a staff member. No row means organization-wide.
model OrgUserBranch {
  id             String @id @default(uuid(7)) @db.Uuid
  organizationId String @db.Uuid
  orgUserId      String @db.Uuid
  branchId       String @db.Uuid

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  orgUser      OrgUser      @relation(fields: [orgUserId], references: [id], onDelete: Cascade)
  branch       Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([orgUserId, branchId])
  @@index([organizationId, branchId])
  @@map("org_user_branches")
}

/// System roles have organizationId = null and are shared by every tenant.
/// A gym may clone one into a custom role it then edits.
model Role {
  id             String  @id @default(uuid(7)) @db.Uuid
  organizationId String? @db.Uuid
  key            String
  name           String
  description    String?
  isSystem       Boolean @default(false)
  /// Platform roles are assignable only to platform staff, never inside a gym.
  isPlatform     Boolean @default(false)
  rank           Int     @default(100)

  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  permissions RolePermission[]
  orgUsers    OrgUser[]

  @@unique([organizationId, key])
  @@index([organizationId])
  @@map("roles")
}

/// Seeded registry of every capability in the product. Global, not tenant data.
model Permission {
  key         String  @id
  domain      String
  resource    String
  action      String
  label       String
  description String?
  /// true when the permission guards salary, medical or credential data
  isSensitive Boolean @default(false)

  roles     RolePermission[]
  overrides UserPermissionOverride[]

  @@index([domain])
  @@map("permissions")
}

model RolePermission {
  id             String  @id @default(uuid(7)) @db.Uuid
  organizationId String? @db.Uuid
  roleId         String  @db.Uuid
  permissionKey  String
  /// scope narrows a grant: ALL, BRANCH or OWN
  scope          String  @default("ALL")

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role         Role          @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission    @relation(fields: [permissionKey], references: [key], onDelete: Cascade)

  @@unique([roleId, permissionKey])
  @@index([permissionKey])
  @@map("role_permissions")
}

/// Per-person grant or deny layered over the role. An explicit deny wins.
model UserPermissionOverride {
  id             String  @id @default(uuid(7)) @db.Uuid
  organizationId String  @db.Uuid
  orgUserId      String  @db.Uuid
  permissionKey  String
  allow          Boolean
  scope          String  @default("ALL")
  reason         String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  createdByUserId String? @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  orgUser      OrgUser      @relation(fields: [orgUserId], references: [id], onDelete: Cascade)
  permission   Permission   @relation(fields: [permissionKey], references: [key], onDelete: Cascade)

  @@unique([orgUserId, permissionKey])
  @@index([organizationId])
  @@map("user_permission_overrides")
}

/// A live session. organizationId is the acting tenant and is the ONLY
/// source of tenant identity at runtime — never a URL, header or body value.
model Session {
  id             String      @id @default(uuid(7)) @db.Uuid
  userId         String      @db.Uuid
  organizationId String?     @db.Uuid
  type           SessionType @default(WEB)

  tokenHash        String    @unique
  refreshTokenHash String?   @unique
  expiresAt        DateTime  @db.Timestamptz(3)
  refreshExpiresAt DateTime? @db.Timestamptz(3)
  revokedAt        DateTime? @db.Timestamptz(3)

  mfaSatisfiedAt DateTime? @db.Timestamptz(3)
  ipAddress      String?
  userAgent      String?
  deviceId       String?

  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  lastActiveAt   DateTime @default(now()) @db.Timestamptz(3)

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("sessions")
}

/// Brute-force defence. Global by email and IP, not tenant-scoped.
model LoginAttempt {
  id          String   @id @default(uuid(7)) @db.Uuid
  email       String
  ipAddress   String?
  succeeded   Boolean
  reason      String?
  attemptedAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([email, attemptedAt])
  @@index([ipAddress, attemptedAt])
  @@map("login_attempts")
}

/// Versioned, timestamped consent. Required before storing health data,
/// progress photographs or sending marketing messages.
model Consent {
  id             String             @id @default(uuid(7)) @db.Uuid
  organizationId String             @db.Uuid
  subjectType    ConsentSubjectType
  subjectId      String             @db.Uuid
  consentType    ConsentType
  granted        Boolean
  policyVersion  String
  grantedAt      DateTime           @default(now()) @db.Timestamptz(3)
  revokedAt      DateTime?          @db.Timestamptz(3)
  ipAddress      String?
  userAgent      String?
  capturedByUserId String?          @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, subjectType, subjectId])
  @@index([organizationId, consentType])
  @@map("consents")
}
// ===========================================================================
//  MEMBERS AND CRM
// ===========================================================================

model Member {
  id             String       @id @default(uuid(7)) @db.Uuid
  organizationId String       @db.Uuid
  branchId       String?      @db.Uuid
  memberCode     String
  /// Linked only once the member activates app access. Members without a
  /// login still exist fully; the gym may have registered them at reception.
  userId         String?      @db.Uuid

  firstName  String
  lastName   String?
  photoFileKey String?
  dateOfBirth DateTime? @db.Date
  gender     Gender?
  phone      String
  altPhone   String?
  email      String?

  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  postalCode   String?
  country      String  @default("IN")

  emergencyContactName     String?
  emergencyContactPhone    String?
  emergencyContactRelation String?

  joiningDate   DateTime     @db.Date
  status        MemberStatus @default(ACTIVE)
  fitnessGoals  String[]     @default([])
  occupation    String?
  bloodGroup    String?
  referredBy    String?
  notes         String?

  assignedTrainerOrgUserId String? @db.Uuid
  convertedFromLeadId      String? @unique @db.Uuid

  /// Denormalised for fast dashboards. Recomputed by the subscription
  /// service inside the same transaction that changes a subscription.
  activeSubscriptionId String?   @db.Uuid
  membershipExpiresAt  DateTime? @db.Date
  lastVisitAt          DateTime? @db.Timestamptz(3)
  outstandingAmount    Decimal   @default(0) @db.Decimal(12, 2)

  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt       DateTime? @db.Timestamptz(3)
  createdByUserId String?   @db.Uuid

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch          Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  user            User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  assignedTrainer OrgUser?     @relation("MemberAssignedTrainer", fields: [assignedTrainerOrgUserId], references: [id], onDelete: SetNull)
  convertedFromLead Lead?      @relation("LeadConvertedMember", fields: [convertedFromLeadId], references: [id], onDelete: SetNull)

  documents          MemberDocument[]
  medicalDeclaration MemberMedicalDeclaration?
  timelineEntries    MemberTimelineEntry[]
  subscriptions      Subscription[]
  attendance         Attendance[]
  qrTokens           MemberQrToken[]
  invoices           Invoice[]
  payments           Payment[]
  workoutAssignments MemberWorkoutAssignment[]
  workoutLogs        WorkoutLog[]
  assessments        FitnessAssessment[]
  progressPhotos     ProgressPhoto[]
  classBookings      ClassBooking[]
  videoProgress      VideoProgress[]
  trainerAssignments TrainerAssignment[]

  @@unique([organizationId, memberCode])
  @@index([organizationId, status])
  @@index([organizationId, branchId, status])
  @@index([organizationId, phone])
  @@index([organizationId, membershipExpiresAt])
  @@index([organizationId, assignedTrainerOrgUserId])
  @@index([organizationId, deletedAt])
  @@map("members")
}

model MemberDocument {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @db.Uuid
  memberId       String   @db.Uuid
  documentType   String
  title          String
  fileKey        String
  mimeType       String?
  sizeBytes      Int?
  expiresAt      DateTime? @db.Date
  uploadedByUserId String? @db.Uuid
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  deletedAt      DateTime? @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  member       Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([organizationId, memberId])
  @@map("member_documents")
}

/// Health data. Separate table, separately permissioned, consent-gated.
/// Access requires members.medical.read and writes an audit row every time.
model MemberMedicalDeclaration {
  id             String  @id @default(uuid(7)) @db.Uuid
  organizationId String  @db.Uuid
  memberId       String  @unique @db.Uuid

  hasDeclaredConditions Boolean  @default(false)
  conditions            String[] @default([])
  medications           String?
  allergies             String?
  injuries              String?
  surgeries             String?
  physicianName         String?
  physicianPhone        String?
  fitnessClearanceGiven Boolean  @default(false)
  clearanceDocumentKey  String?
  additionalNotes       String?

  declaredAt      DateTime  @default(now()) @db.Timestamptz(3)
  reviewedAt      DateTime? @db.Timestamptz(3)
  reviewedByUserId String?  @db.Uuid
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  member       Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("member_medical_declarations")
}

/// Unified member activity feed: registrations, visits, payments, messages,
/// plan changes. Written by services, never edited by hand.
model MemberTimelineEntry {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @db.Uuid
  memberId       String   @db.Uuid
  entryType      String
  title          String
  body           String?
  sourceType     String?
  sourceId       String?  @db.Uuid
  metadata       Json?    @db.JsonB
  occurredAt     DateTime @default(now()) @db.Timestamptz(3)
  actorUserId    String?  @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  member       Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([organizationId, memberId, occurredAt])
  @@map("member_timeline_entries")
}

model Lead {
  id             String     @id @default(uuid(7)) @db.Uuid
  organizationId String     @db.Uuid
  branchId       String?    @db.Uuid

  fullName String
  phone    String
  email    String?
  city     String?

  source       LeadSource @default(WALK_IN)
  sourceDetail String?
  status       LeadStatus @default(NEW)

  interestedPlanId String?   @db.Uuid
  budgetNote       String?
  nextFollowUpAt   DateTime? @db.Timestamptz(3)
  assignedToOrgUserId String? @db.Uuid

  lostReason   String?
  lostAt       DateTime? @db.Timestamptz(3)
  convertedAt  DateTime? @db.Timestamptz(3)
  notes        String?

  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt       DateTime? @db.Timestamptz(3)
  createdByUserId String?   @db.Uuid

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch         Branch?         @relation(fields: [branchId], references: [id], onDelete: SetNull)
  assignedTo     OrgUser?        @relation("LeadAssignedTo", fields: [assignedToOrgUserId], references: [id], onDelete: SetNull)
  interestedPlan MembershipPlan? @relation(fields: [interestedPlanId], references: [id], onDelete: SetNull)

  convertedMember Member?        @relation("LeadConvertedMember")
  activities      LeadActivity[]
  trialBookings   TrialBooking[]

  @@index([organizationId, status])
  @@index([organizationId, nextFollowUpAt])
  @@index([organizationId, assignedToOrgUserId, status])
  @@index([organizationId, source])
  @@index([organizationId, phone])
  @@map("leads")
}

model LeadActivity {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @db.Uuid
  leadId         String   @db.Uuid
  activityType   String
  outcome        String?
  notes          String?
  occurredAt     DateTime @default(now()) @db.Timestamptz(3)
  nextFollowUpAt DateTime? @db.Timestamptz(3)
  actorOrgUserId String?  @db.Uuid

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead         Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  actor        OrgUser?     @relation(fields: [actorOrgUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, leadId, occurredAt])
  @@map("lead_activities")
}

model TrialBooking {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @db.Uuid
  leadId         String   @db.Uuid
  scheduledFor   DateTime @db.Timestamptz(3)
  trainerOrgUserId String? @db.Uuid
  attended       Boolean?
  feedback       String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead         Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  trainer      OrgUser?     @relation(fields: [trainerOrgUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, scheduledFor])
  @@map("trial_bookings")
}
// ===========================================================================
//  MEMBERSHIPS, ATTENDANCE AND FINANCE
//
//  Financial history is append-only. A correction is a new row plus a
//  reversal; nothing overwrites a recorded payment or issued invoice.
// ===========================================================================

model MembershipPlan {
  id             String       @id @default(uuid(7)) @db.Uuid
  organizationId String       @db.Uuid

  name        String
  description String?
  category    PlanCategory     @default(GENERAL)
  durationUnit PlanDurationUnit @default(MONTH)
  durationValue Int             @default(1)
  /// For session-based packages such as 10 personal-training sessions.
  sessionCount Int?

  price     Decimal @db.Decimal(12, 2)
  taxRateId String? @db.Uuid
  /// true when `price` already includes tax
  priceIncludesTax Boolean @default(true)

  joiningFee       Decimal @default(0) @db.Decimal(12, 2)
  securityDeposit  Decimal @default(0) @db.Decimal(12, 2)

  /// Access rules: time windows, branch access, guest passes, included services
  accessRules      Json?   @db.JsonB
  includedServices String[] @default([])

  availableAtAllBranches Boolean @default(true)
  freezeAllowed          Boolean @default(false)
  freezeMaxDays          Int     @default(0)
  graceDays              Int     @default(0)
  autoRenew              Boolean @default(false)
  discountAllowed        Boolean @default(true)
  transferAllowed        Boolean @default(false)

  isActive    Boolean  @default(true)
  displayOrder Int     @default(0)
  visibleToMembers Boolean @default(true)

  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  taxRate      TaxRate?     @relation(fields: [taxRateId], references: [id], onDelete: SetNull)

  planBranches  PlanBranch[]
  subscriptions Subscription[]
  interestedLeads Lead[]
  invoiceLines  InvoiceLine[]

  @@unique([organizationId, name])
  @@index([organizationId, isActive])
  @@map("membership_plans")
}

model PlanBranch {
  id             String @id @default(uuid(7)) @db.Uuid
  organizationId String @db.Uuid
  planId         String @db.Uuid
  branchId       String @db.Uuid

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan         MembershipPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  branch       Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([planId, branchId])
  @@index([organizationId, branchId])
  @@map("plan_branches")
}

model Subscription {
  id             String             @id @default(uuid(7)) @db.Uuid
  organizationId String             @db.Uuid
  memberId       String             @db.Uuid
  planId         String             @db.Uuid
  branchId       String?            @db.Uuid

  status    SubscriptionStatus @default(PENDING)
  startDate DateTime           @db.Date
  endDate   DateTime           @db.Date
  /// endDate plus the plan's grace days; check-in is blocked past this.
  graceUntil DateTime?         @db.Date

  /// Price actually agreed, which may differ from the plan's list price.
  listPrice      Decimal @db.Decimal(12, 2)
  discountAmount Decimal @default(0) @db.Decimal(12, 2)
  discountId     String? @db.Uuid
  taxableAmount  Decimal @db.Decimal(12, 2)
  taxAmount      Decimal @default(0) @db.Decimal(12, 2)
  totalAmount    Decimal @db.Decimal(12, 2)
  paidAmount     Decimal @default(0) @db.Decimal(12, 2)

  sessionsTotal     Int?
  sessionsConsumed  Int  @default(0)

  frozenDaysUsed Int @default(0)
  autoRenew      Boolean @default(false)

  previousSubscriptionId String? @db.Uuid
  cancelledAt     DateTime? @db.Timestamptz(3)
  cancelReason    String?

  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt       DateTime? @db.Timestamptz(3)
  createdByUserId String?   @db.Uuid

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  member       Member         @relation(fields: [memberId], references: [id], onDelete: Cascade)
  plan         MembershipPlan @relation(fields: [planId], references: [id])
  branch       Branch?        @relation(fields: [branchId], references: [id], onDelete: SetNull)
  discount     Discount?      @relation(fields: [discountId], references: [id], onDelete: SetNull)

  events       SubscriptionEvent[]
  freezes      SubscriptionFreeze[]
  invoiceLines InvoiceLine[]
  attendance   Attendance[]
  payments     Payment[]

  @@index([organizationId, status])
  @@index([organizationId, memberId, status])
  @@index([organizationId, endDate, status])
  @@index([organizationId, branchId, status])
  @@map("subscriptions")
}

/// Append-only history of everything that happened to a subscription.
model SubscriptionEvent {
  id             String                @id @default(uuid(7)) @db.Uuid
  organizationId String                @db.Uuid
  subscriptionId String                @db.Uuid
  eventType      SubscriptionEventType
  effectiveDate  DateTime              @db.Date
  daysDelta      Int                   @default(0)
  amountDelta    Decimal               @default(0) @db.Decimal(12, 2)

  fromPlanId String? @db.Uuid
  toPlanId   String? @db.Uuid
  fromBranchId String? @db.Uuid
  toBranchId   String? @db.Uuid

  reason   String?
  metadata Json?   @db.JsonB

  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  actorUserId   String?  @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([organizationId, subscriptionId, createdAt])
  @@index([organizationId, eventType])
  @@map("subscription_events")
}

model SubscriptionFreeze {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @db.Uuid
  subscriptionId String   @db.Uuid
  fromDate       DateTime @db.Date
  toDate         DateTime @db.Date
  daysCredited   Int
  reason         String?
  liftedEarlyAt  DateTime? @db.Timestamptz(3)

  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  actorUserId   String?  @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([organizationId, subscriptionId])
  @@map("subscription_freezes")
}

/// One row per member per day. The unique constraint is the duplicate
/// check-in guard — it lives in the database, not in the interface.
model Attendance {
  id             String           @id @default(uuid(7)) @db.Uuid
  organizationId String           @db.Uuid
  branchId       String?          @db.Uuid
  memberId       String           @db.Uuid
  subscriptionId String?          @db.Uuid

  attendanceDate DateTime         @db.Date
  checkedInAt    DateTime         @default(now()) @db.Timestamptz(3)
  checkedOutAt   DateTime?        @db.Timestamptz(3)
  durationMinutes Int?
  method         AttendanceMethod @default(MEMBER_QR)

  /// Captured at the moment of entry so the record stays truthful later.
  subscriptionStatusAtEntry SubscriptionStatus?
  wasOverride      Boolean @default(false)
  overrideReason   String?

  recordedByUserId String? @db.Uuid
  deviceLabel      String?

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)
  member       Member        @relation(fields: [memberId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@unique([memberId, attendanceDate])
  @@index([organizationId, attendanceDate])
  @@index([organizationId, branchId, attendanceDate])
  @@index([organizationId, memberId, attendanceDate])
  @@map("attendance")
}

/// Rotating QR secret. A static code can be screenshotted and shared;
/// this one is re-issued and the previous token is revoked.
model MemberQrToken {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @db.Uuid
  memberId       String    @db.Uuid
  tokenHash      String    @unique
  issuedAt       DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt      DateTime? @db.Timestamptz(3)
  revokedAt      DateTime? @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  member       Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([organizationId, memberId, revokedAt])
  @@map("member_qr_tokens")
}

/// The code displayed at the gym entrance for members to scan.
model BranchQrCode {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @db.Uuid
  branchId       String    @db.Uuid
  label          String?
  tokenHash      String    @unique
  rotatedAt      DateTime  @default(now()) @db.Timestamptz(3)
  revokedAt      DateTime? @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([organizationId, branchId])
  @@map("branch_qr_codes")
}

model TaxRate {
  id             String  @id @default(uuid(7)) @db.Uuid
  organizationId String  @db.Uuid
  name           String
  /// Total percentage, e.g. 18.00 for 18% GST
  percentage     Decimal @db.Decimal(5, 2)
  /// Component split for Indian GST, e.g. { "cgst": 9, "sgst": 9 }
  components     Json?   @db.JsonB
  hsnSacCode     String?
  isDefault      Boolean @default(false)
  isActive       Boolean @default(true)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  plans        MembershipPlan[]
  invoiceLines InvoiceLine[]
  products     Product[]

  @@unique([organizationId, name])
  @@index([organizationId, isActive])
  @@map("tax_rates")
}

/// Per-organization, per-series, per-financial-year counter. Allocated
/// under a row lock so invoice numbering is gapless under concurrency.
model InvoiceSequence {
  id             String @id @default(uuid(7)) @db.Uuid
  organizationId String @db.Uuid
  series         String
  financialYear  String
  prefix         String
  nextNumber     Int    @default(1)
  padding        Int    @default(5)

  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, series, financialYear])
  @@map("invoice_sequences")
}

model Invoice {
  id             String        @id @default(uuid(7)) @db.Uuid
  organizationId String        @db.Uuid
  branchId       String?       @db.Uuid
  memberId       String?       @db.Uuid

  series        String   @default("INV")
  financialYear String
  invoiceNumber Int
  invoiceCode   String

  status    InvoiceStatus @default(DRAFT)
  issueDate DateTime      @db.Date
  dueDate   DateTime?     @db.Date

  subtotal       Decimal @db.Decimal(12, 2)
  discountAmount Decimal @default(0) @db.Decimal(12, 2)
  taxAmount      Decimal @default(0) @db.Decimal(12, 2)
  roundingAmount Decimal @default(0) @db.Decimal(12, 2)
  total          Decimal @db.Decimal(12, 2)
  amountPaid     Decimal @default(0) @db.Decimal(12, 2)
  amountDue      Decimal @default(0) @db.Decimal(12, 2)

  placeOfSupply String?
  customerGstin String?
  notes         String?
  pdfFileKey    String?

  cancelledAt     DateTime? @db.Timestamptz(3)
  cancelReason    String?

  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)
  createdByUserId String?  @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  member       Member?      @relation(fields: [memberId], references: [id], onDelete: SetNull)

  lines    InvoiceLine[]
  payments Payment[]
  refunds  Refund[]

  @@unique([organizationId, series, financialYear, invoiceNumber])
  @@unique([organizationId, invoiceCode])
  @@index([organizationId, status])
  @@index([organizationId, memberId])
  @@index([organizationId, issueDate])
  @@map("invoices")
}

model InvoiceLine {
  id             String  @id @default(uuid(7)) @db.Uuid
  organizationId String  @db.Uuid
  invoiceId      String  @db.Uuid

  description String
  itemType    String
  planId         String? @db.Uuid
  subscriptionId String? @db.Uuid
  productId      String? @db.Uuid

  quantity   Decimal @default(1) @db.Decimal(10, 3)
  unitPrice  Decimal @db.Decimal(12, 2)
  discountAmount Decimal @default(0) @db.Decimal(12, 2)
  taxRateId  String? @db.Uuid
  taxPercentage Decimal @default(0) @db.Decimal(5, 2)
  taxAmount  Decimal @default(0) @db.Decimal(12, 2)
  lineTotal  Decimal @db.Decimal(12, 2)
  hsnSacCode String?
  displayOrder Int   @default(0)

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoice      Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  plan         MembershipPlan? @relation(fields: [planId], references: [id], onDelete: SetNull)
  subscription Subscription?   @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  product      Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  taxRate      TaxRate?        @relation(fields: [taxRateId], references: [id], onDelete: SetNull)

  @@index([organizationId, invoiceId])
  @@map("invoice_lines")
}

/// A payment exists only after its gateway webhook signature verifies.
/// Cash and UPI entries are recorded by staff and carry recordedByUserId.
model Payment {
  id             String        @id @default(uuid(7)) @db.Uuid
  organizationId String        @db.Uuid
  branchId       String?       @db.Uuid
  memberId       String?       @db.Uuid
  invoiceId      String?       @db.Uuid
  subscriptionId String?       @db.Uuid

  receiptCode String?
  amount      Decimal       @db.Decimal(12, 2)
  currency    String        @default("INR")
  method      PaymentMethod
  status      PaymentStatus @default(PENDING)

  referenceNumber   String?
  razorpayOrderId   String? @unique
  razorpayPaymentId String? @unique
  razorpaySignature String?
  gatewayFee        Decimal? @db.Decimal(12, 2)
  gatewayPayload    Json?    @db.JsonB

  receivedAt       DateTime  @default(now()) @db.Timestamptz(3)
  settledAt        DateTime? @db.Timestamptz(3)
  failureReason    String?
  notes            String?
  receiptFileKey   String?

  createdAt        DateTime @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @db.Timestamptz(3)
  recordedByUserId String?  @db.Uuid

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)
  member       Member?       @relation(fields: [memberId], references: [id], onDelete: SetNull)
  invoice      Invoice?      @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  refunds Refund[]

  @@unique([organizationId, receiptCode])
  @@index([organizationId, status, receivedAt])
  @@index([organizationId, memberId])
  @@index([organizationId, branchId, receivedAt])
  @@index([organizationId, method])
  @@map("payments")
}

model Refund {
  id             String       @id @default(uuid(7)) @db.Uuid
  organizationId String       @db.Uuid
  paymentId      String       @db.Uuid
  invoiceId      String?      @db.Uuid

  amount Decimal      @db.Decimal(12, 2)
  status RefundStatus @default(REQUESTED)
  reason String

  razorpayRefundId String? @unique
  gatewayPayload   Json?   @db.JsonB

  requestedAt       DateTime  @default(now()) @db.Timestamptz(3)
  approvedAt        DateTime? @db.Timestamptz(3)
  processedAt       DateTime? @db.Timestamptz(3)
  requestedByUserId String?   @db.Uuid
  approvedByUserId  String?   @db.Uuid
  failureReason     String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  payment      Payment      @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoice      Invoice?     @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@map("refunds")
}

model Discount {
  id             String       @id @default(uuid(7)) @db.Uuid
  organizationId String       @db.Uuid
  code           String
  name           String
  discountType   DiscountType @default(PERCENTAGE)
  value          Decimal      @db.Decimal(10, 2)
  maxDiscountAmount Decimal?  @db.Decimal(12, 2)

  applicablePlanIds String[] @default([])
  validFrom         DateTime? @db.Date
  validUntil        DateTime? @db.Date
  maxUses           Int?
  maxUsesPerMember  Int      @default(1)
  usedCount         Int      @default(0)
  isActive          Boolean  @default(true)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscriptions Subscription[]

  @@unique([organizationId, code])
  @@index([organizationId, isActive])
  @@map("discounts")
}

model ExpenseCategory {
  id             String  @id @default(uuid(7)) @db.Uuid
  organizationId String  @db.Uuid
  name           String
  description    String?
  isActive       Boolean @default(true)

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  expenses     Expense[]

  @@unique([organizationId, name])
  @@map("expense_categories")
}

model Vendor {
  id             String  @id @default(uuid(7)) @db.Uuid
  organizationId String  @db.Uuid
  name           String
  contactPerson  String?
  phone          String?
  email          String?
  gstin          String?
  address        String?
  notes          String?
  isActive       Boolean @default(true)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  expenses          Expense[]
  products          Product[]
  equipment         Equipment[]
  maintenanceLogs   EquipmentMaintenanceLog[]

  @@unique([organizationId, name])
  @@map("vendors")
}

model Expense {
  id             String  @id @default(uuid(7)) @db.Uuid
  organizationId String  @db.Uuid
  branchId       String? @db.Uuid
  categoryId     String? @db.Uuid
