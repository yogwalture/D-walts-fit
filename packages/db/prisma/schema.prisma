/// organizationId null = a platform-provided default template a gym may clone.
model NotificationTemplate {
  id             String                 @id @default(uuid(7)) @db.Uuid
  organizationId String?                @db.Uuid
  key            String
  name           String
  channel        NotificationChannel
  category       MessageCategory        @default(UTILITY)
  language       String                 @default("en")

  subject String?
  body    String
  /// Variable names the body expects, e.g. ["memberName","expiryDate"]
  variables String[] @default([])

  /// Meta's approved template name — required before a WhatsApp send.
  providerTemplateName String?
  approvalStatus       TemplateApprovalStatus @default(DRAFT)
  approvalNote         String?
  submittedAt          DateTime?              @db.Timestamptz(3)
  approvedAt           DateTime?              @db.Timestamptz(3)

  isActive Boolean @default(true)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  messageJobs MessageJob[]
  messages    Message[]

  @@unique([organizationId, key, channel, language])
  @@index([organizationId, channel])
  @@map("notification_templates")
}

/// A campaign or an automation run: who it targets, when it runs, how it went.
model MessageJob {
  id             String              @id @default(uuid(7)) @db.Uuid
  organizationId String              @db.Uuid
  name           String
  channel        NotificationChannel
  category       MessageCategory     @default(UTILITY)
  templateId     String?             @db.Uuid

  /// Saved audience filter, resolved to recipients when the job runs.
  audienceFilter Json?     @db.JsonB
  scheduledAt    DateTime? @db.Timestamptz(3)
  startedAt      DateTime? @db.Timestamptz(3)
  completedAt    DateTime? @db.Timestamptz(3)
  status         MessageJobStatus @default(DRAFT)

  recipientCount Int @default(0)
  sentCount      Int @default(0)
  deliveredCount Int @default(0)
  failedCount    Int @default(0)
  skippedCount   Int @default(0)
  /// Estimate shown before dispatch and reconciled after.
  estimatedCost  Decimal @default(0) @db.Decimal(12, 2)
  actualCost     Decimal @default(0) @db.Decimal(12, 2)

  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)
  createdByUserId String?  @db.Uuid

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  template     NotificationTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  messages Message[]

  @@index([organizationId, status, scheduledAt])
  @@map("message_jobs")
}

model Message {
  id             String              @id @default(uuid(7)) @db.Uuid
  organizationId String              @db.Uuid
  messageJobId   String?             @db.Uuid
  templateId     String?             @db.Uuid

  channel       NotificationChannel
  category      MessageCategory     @default(UTILITY)
  recipientType RecipientType
  recipientId   String?             @db.Uuid
  toAddress     String

  payload   Json?         @db.JsonB
  renderedBody String?
  status    MessageStatus @default(QUEUED)

  providerMessageId String?   @unique
  providerResponse  Json?     @db.JsonB
  errorCode         String?
  errorMessage      String?
  costUnits         Decimal   @default(0) @db.Decimal(10, 4)

  queuedAt    DateTime  @default(now()) @db.Timestamptz(3)
  sentAt      DateTime? @db.Timestamptz(3)
  deliveredAt DateTime? @db.Timestamptz(3)
  readAt      DateTime? @db.Timestamptz(3)
  failedAt    DateTime? @db.Timestamptz(3)
  attempts    Int       @default(0)

  /// Guards against a double-send when a provider call times out after
  /// it actually succeeded.
  idempotencyKey String? @unique

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  messageJob   MessageJob?           @relation(fields: [messageJobId], references: [id], onDelete: SetNull)
  template     NotificationTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@index([organizationId, status, queuedAt])
  @@index([organizationId, recipientType, recipientId])
  @@index([organizationId, channel, sentAt])
  @@map("messages")
}

